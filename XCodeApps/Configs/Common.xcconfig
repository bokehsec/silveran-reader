DEVELOPMENT_TEAM = 9CJ7KG7UKQ
APP_BUNDLE_ID = com.kyonifer.SilveranReader
WATCH_APP_BUNDLE_ID = $(APP_BUNDLE_ID).watchkitapp
APP_GROUP_ID = group.$(APP_BUNDLE_ID)
// macOS only auto-grants sandbox access to Team-ID-prefixed group containers;
// group.* style prompts the user for consent on macOS 15+.
MAC_APP_GROUP_ID = $(DEVELOPMENT_TEAM).group.$(APP_BUNDLE_ID)
KEYCHAIN_GROUP_SUFFIX = com.kyonifer.silveran.shared
KEYCHAIN_SERVICE = com.kyonifer.silveran.storyteller
KEYCHAIN_ACCESS_GROUP = $(AppIdentifierPrefix)$(KEYCHAIN_GROUP_SUFFIX)

// One signed KVS namespace shared by the macOS and iOS apps.
ICLOUD_KVS_IDENTIFIER = $(TeamIdentifierPrefix)$(APP_BUNDLE_ID)

// Automatic iCloud backup (docs/decisions/009-backup-archive-and-icloud-transport.md).
// Off by default: the app offers backup files only. To turn it on, create the CloudKit
// container for your App ID in the Apple Developer portal, then override these three in
// Local.xcconfig (see Local.example.xcconfig). Never set the container without the matching
// entitlements: CloudKit refuses containers the app isn't entitled to.
SILVERAN_CLOUD_BACKUP_CONTAINER =
SILVERAN_IOS_ENTITLEMENTS = XCodeApps/SilveranReaderIos.entitlements
SILVERAN_MAC_ENTITLEMENTS = XCodeApps/SilveranReaderMac.entitlements
